{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/runner",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
