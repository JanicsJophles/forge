# Network
PORT=5000
# Address to bind the HTTP server to (default 0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Concurrency & limits
MAX_CONCURRENT_TASKS=2
# Hung-agent timeout in ms: SIGTERM then SIGKILL a task that runs this long
# (default 1800000 = 30m; valid 1..2147483647)
TASK_TIMEOUT_MS=1800000
# Admission disk guard: reject new tasks when free disk is below this many MB
# (default 2048)
MIN_FREE_DISK_MB=2048

# Repos
ALLOWED_REPO_PATHS=/repos

# Commit behaviour
# Auto-commit is OFF by default (opt-in). Set to true/1 to commit changes
# after successful runs. A per-task autoCommit in the POST body overrides this.
AUTO_COMMIT=false
COMMIT_MESSAGE_PREFIX=[forge]

# Logging
LOG_LEVEL=info

# Run users (unprivileged; --dangerously-skip-permissions is blocked for root)
# CLAUDE_RUN_USER=forge  # user to run the claude provider as (default forge)
# CODEX_RUN_USER=forge   # user to run the codex provider as (default forge)
