PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
AUTO_COMMIT=true
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
# Owner limits. Requests can choose any positive value up to MAX_*.
DEFAULT_WALL_MINUTES=30
MAX_WALL_MINUTES=60
DEFAULT_OUTPUT_BYTES=5242880
MAX_OUTPUT_BYTES=10485760
GATE_TIMEOUT_MS=300000
ALLOW_WORKFLOW_EDITS=false
# JSON array of regex strings applied to added diff content.
FORBIDDEN_DIFF_PATTERNS=[]
