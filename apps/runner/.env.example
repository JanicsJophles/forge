PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
# Auto-commit is OFF by default (opt-in). Set to true/1 to commit changes
# after successful runs. A per-task autoCommit in the POST body overrides this.
AUTO_COMMIT=false
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
