PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
AUTO_COMMIT=true
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
# Bearer token for state-changing task routes (POST /tasks, DELETE /tasks/:id, ...).
# Generate with: openssl rand -hex 32. Unset = no auth (a warning is logged at startup).
# FORGE_RUNNER_TOKEN=
