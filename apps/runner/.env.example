PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
AUTO_COMMIT=true
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
# CODEX_RUN_USER=forge   # unprivileged user to run codex as (optional)

# --- Read-only tasks (optional) ---
# Dedicated, credential-less account for read-only tasks. When unset or missing,
# GET /tasks/capabilities reports readOnly:false and read-only tasks are refused.
# See the "Read-only tasks" section of the README for the one-time account setup.
# READONLY_RUN_USER=forge-ro                       # MUST differ (uid AND gid) from CLAUDE/CODEX_RUN_USER
# READONLY_CLAUDE_CONFIG_DIR=/etc/forge-ro/claude  # pristine CLAUDE_CONFIG_DIR source (copied per-task into a 0700 HOME)
# READONLY_CODEX_HOME=/etc/forge-ro/codex          # pristine CODEX_HOME source (copied per-task into a 0700 HOME)
# READONLY_BASE_DIR=/var/lib/forge/ro              # root-owned 0711 base dir for disposable copies (never /tmp)
# READONLY_PREP_TIMEOUT_MS=120000                  # cap on read-only copy preparation
# TASK_TIMEOUT_MS=3600000                          # wall-clock cap on a read-only task (0 disables); writable never capped
# KILL_GRACE_MS=10000                              # SIGTERM→SIGKILL grace when terminating a task
