PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
AUTO_COMMIT=true
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
# --- RAC-378 stuckpoint capture ---
# AGENT_BOARD_URL=http://127.0.0.1:5000  # where candidates are POSTed (default: loopback to co-located board)
# CAPTURE_ENABLED=true                    # set false to fully disable the stuckpoint-capture hook
