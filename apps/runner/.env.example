PORT=5000
MAX_CONCURRENT_TASKS=2
ALLOWED_REPO_PATHS=/repos
AUTO_COMMIT=true
COMMIT_MESSAGE_PREFIX=[forge]
LOG_LEVEL=info
# CLAUDE_RUN_USER=forge  # unprivileged user to run claude as (optional)
# CODEX_RUN_USER=forge   # unprivileged user to run codex as (optional)

# --- Read-only tasks (optional) ---
# Dedicated, credential-less account for read-only tasks. When unset or missing,
# GET /tasks/capabilities reports readOnly:false and read-only tasks are refused.
# See the "Read-only tasks" section of the README for the one-time account setup.
# READONLY_RUN_USER=forge-ro
# READONLY_CLAUDE_CONFIG_DIR=/etc/forge-ro/claude  # CLAUDE_CONFIG_DIR for read-only claude runs
# READONLY_CODEX_HOME=/etc/forge-ro/codex          # CODEX_HOME for read-only codex runs
